{
  "name": "poker-lab",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @poker-lab/db generate",
    "db:migrate": "pnpm --filter @poker-lab/db migrate"
  }
}
